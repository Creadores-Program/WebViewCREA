{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, target-url"
      }
    }
  ],
  "headers": [{
    "source": "/api/(.*)",
    "headers": [
    {
      "key": "Cache-Control",
      "value": "public, max-age=864000, s-maxage=864000, stale-while-revalidate=86400"
    },
    {
      "key": "Connection",
      "value": "keep-alive"
    },
    {
      "key": "Keep-Alive",
      "value": "timeout=60, max=100"
    },
    {
      "key": "Access-Control-Allow-Origin",
      "value": "*"
    },
    {
      "key": "Access-Control-Allow-Methods",
      "value": "POST, OPTIONS"
    },
    {
      "key": "Access-Control-Allow-Headers",
      "value": "Content-Type"
    },
    {
      "key": "Vary",
      "value": "target-url, Accept, Content-Type"
    }]
  }]
}
