{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, target-url",
        "Vary": "target-url, Accept, Content-Type",
        "Cache-Control": "public, max-age=864000, s-maxage=864000, stale-while-revalidate=86400",
        "Connection": "keep-alive",
        "Keep-Alive": "timeout=60, max=100"
      }
    }
  ]
}
